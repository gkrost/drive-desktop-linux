# =============================================================================
# Internxt Drive Desktop - Environment Configuration
# =============================================================================
#
# HOW ENV VARS WORK IN THIS PROJECT (important quirk):
#
#   PRODUCTION builds: dotenv-webpack replaces process.env.* references at
#   webpack compile time. The .env file is read during `npm run build` and
#   values are baked into the JS bundle as string literals. The .env file
#   is NOT shipped in the packaged app.
#
#   DEVELOPMENT builds: The main process is also compiled by webpack (via
#   webpack.config.main.dev.ts) before Electron launches it, so dotenv-webpack
#   handles substitution here too. As a safety net, main.ts also imports
#   'dotenv/config' at the top — but the webpack plugin is the primary source.
#
#   IMPORTANT: Shell env vars (export FOO=bar) have NO effect on the running
#   app. All values must be in this .env file and the app must be recompiled
#   after changes.
#
# Production gateway URLs (from publish.yml):
#   https://gateway.internxt.com/{drive,api,payments,network}
# =============================================================================


# -- Encryption ---------------------------------------------------------------
# All four keys are required. The app will crash on startup without NEW_CRYPTO_KEY.
# Values are hex-encoded strings; obtain them from the Internxt team or server config.

# Legacy AES key used by the renderer login flow (CryptoJS.AES.encrypt)
CRYPTO_KEY=

# Legacy IV and salt for password hashing (may be unused in newer flows, but still required)
MAGIC_IV=
MAGIC_SALT=

# REQUIRED — Primary AES key for file-name encryption/decryption (deterministic mode).
# The app throws "No encryption key provided" at startup if this is empty.
NEW_CRYPTO_KEY=


# -- Server URLs / Endpoints -------------------------------------------------
# Base URLs without trailing slash. All are HTTPS in production.

# Primary Drive REST API (files, folders, trash, shares — used in 20+ source files)
NEW_DRIVE_URL=

# Alternative Drive API endpoint (logged at startup, rarely used directly)
DRIVE_API_URL=

# Payments / subscription service
PAYMENTS_URL=

# Bridge / network service (downloads, uploads, SDK configuration)
BRIDGE_URL=

# WebSocket endpoint for real-time file-change notifications (socket.io)
NOTIFICATIONS_URL=

# Bug / error reporting endpoint (POST)
BUG_REPORTING_URL=


# -- Authentication / Headers ------------------------------------------------

# Sent as `x-internxt-desktop-header` on every API request; identifies the desktop client.
# Obtain from Internxt team.
INTERNXT_DESKTOP_HEADER_KEY=


# -- Analytics ----------------------------------------------------------------
# Leave blank to disable analytics. Keys are masked in startup logs.

# Segment.io write key — production
APP_SEGMENT_KEY=

# Segment.io write key — test / staging
APP_SEGMENT_KEY_TEST=

# RudderStack analytics write key
RUDDERSTACK_KEY=

# RudderStack data-plane collection URL (HTTPS)
RUDDERSTACK_DATA_PLANE_URL=


# -- Runtime Parameters -------------------------------------------------------

# How often (in ms) to refresh file locks. Logged at startup. Leave blank for default.
LOCK_REFRESH_INTERVAL=
